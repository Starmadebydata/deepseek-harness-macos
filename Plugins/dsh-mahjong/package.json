{
  "name": "dsh-mahjong",
  "version": "1.0.0",
  "description": "四川麻将·血战到底：人类 vs AI 机器人同桌游戏（Host 规则引擎 + 全屏牌桌 UI）。",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/engine.test.js && node test/sim.js && node test/human-sim.js && node test/win-fuzz.js && node test/static-smoke.mjs"
  },
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js"],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
